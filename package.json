{
  "name": "retail-cashing-up-program",
  "version": "1.0.0",
  "description": "Retail Cashing Up Program for D365 Retail Commerce - Desktop Application with PDF Reports",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.retail.cashingup",
    "productName": "Retail Cashing Up",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "mssql": "^10.0.1",
    "dotenv": "^16.3.1",
    "moment": "^2.29.4",
    "pdfmake": "^0.2.9",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^27.1.0",
    "electron-builder": "^24.9.1"
  },
  "author": "",
  "license": "MIT"
}
