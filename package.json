{
  "name": "nilamel-election-voters-list",
  "version": "2.0.0",
  "description": "Comprehensive Voter Management System for Nilamel Election",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "init-db": "node -e \"require('./database.js')\""
  },
  "keywords": [
    "election",
    "voters",
    "nilamel",
    "panchayat",
    "polling"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
